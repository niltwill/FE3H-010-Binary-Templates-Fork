//------------------------------------------------
//--- 010 Editor v16.0.1 Binary Template
//
//      File: fixed_cut_in.bt
//   Authors: niltwill
//   Version: 1.1
//   Purpose: fixed_cut_in.bin - critical hit cut-in camera & animation data
//  Category: Game Data
// File Mask: fixed_cut_in.bin
//  ID Bytes: 
//   History:
//     1.1 - Field semantics confirmed from 0x7100092fc0
//     1.0 - Initial RE from binary analysis
//------------------------------------------------

// Enums
// Packed in motion_type u32 (LE byte order):
// byte0 = 0x01 (standard) or 0x03 (dual)
// byte1 = 0x00 (standard) or 0x03 (dual)
// byte2 = always 0x00
// byte3 = always 0x00 -> read into DAT_7101abf074 which controls eye open/close state
typedef enum <uint32> {
    MotionType_Standard = 0x00000001,
    MotionType_Dual = 0x00000303,
} MotionType;

// Global Header
typedef struct {
    uint32 section_count <name="Section Count", comment="Always 2">;
    uint32 header_size <name="Header Size", comment="Always 0x14 (20 bytes)">;
    uint32 sec0_data_size <name="Sec0 Data Size", comment="Size of section 0 data excluding global header">;
    uint32 sec0_total_size <name="Sec0 Total Size", comment="Size of section 0 including global header (= data_size + 0x14)">;
    uint32 sec1_size <name="Sec1 Size", comment="Size of section 1 (= file_size - sec0_total_size)">;
} GlobalHeader <name="Global Header", bgcolor=cLtGray>;

// Section Sub-Header
typedef struct {
    uint32 magic <name="Magic", format=hex, comment="Always 0x16121900">;
    uint32 entry_count <name="Entry Count">;
    uint32 entry_stride <name="Entry Stride", format=hex, comment="Byte size of each entry">;
    byte padding[52] <name="Padding", hidden=true, comment="Always zero">;
} SectionSubHeader <name="Sub-Header", bgcolor=cLtYellow>;

// Section 0: Cut-In Camera Parameter Entry
// Two entry groups are here (confirmed from binary data + code):
// 1. Group A (entries 0-3, 20-30): timing_a=1.4s, camera_depth = 1000 - lords / dramatic
// 2. Group B (entries 4-19, 31): timing_a=0.355s, camera_depth = 3000 - supports / sharp
typedef struct {
    // Timing
    float timing_a <name="Timing A", comment="Onset / fade-in duration in seconds. 1.4 = Group A (dramatic); 0.355 = Group B (fast)">;
    float timing_b <name="Timing B", comment="Secondary timing parameter. 0.1 in Group A, 0.0 in Group B">;
    float timing_c <name="Timing C", comment="Hold / sustain duration in seconds. 1.3 in Group A, 0.32 in Group B">;
    float timing_d <name="Timing D", comment="Fade-out duration in seconds. 0.8 in Group A, 1.0 in Group B">;

    // Camera motion scalars
    float smoothing_a <name="Smoothing A", comment="Oscillation damping coefficient A (tiny negative, -0.004 to -0.007).">;
    float smoothing_b <name="Smoothing B", comment="Oscillation damping coefficient B.">;
    float rotation_angle <name="Rotation Angle", comment="Portrait tilt in radians (0.1396 = 8°).">;
    float camera_depth <name="Camera Depth", comment="Z-depth / zoom: 1000 = close-up (Group A), 3000 = wide (Group B).">;
    float camera_y <name="Camera Y", comment="Vertical camera position in world units (190–520).">;

    // Scale (always 1.0)
    float scale_x <name="Scale X", comment="Always 1.0">;
    float scale_y <name="Scale Y", comment="Always 1.0">;
    float scale_z <name="Scale Z", comment="Always 1.0">;

    // Secondary orientation matrix (all-zero in current data)
    // Reserved space for a second set of orient vectors; appears unused but allocated.
    float mat_B_col0[3] <name="Mat_B Col0", comment="Secondary camera orientation vector A - all-zero in current data.">;
    float mat_B_col1[3] <name="Mat_B Col1", comment="Secondary camera orientation vector B - all-zero in current data.">;

    // Camera orientation vectors
    float orient_A[3] <name="Orient A (camera right)", comment="Camera right-vector in model space.">;
    float orient_B[3] <name="Orient B (camera up)", comment="Camera up-vector in model space.">;

    // Face-framing offset matrix (3*3) -> final camera look-at point
    float face_col0[3] <name="Face Matrix Col0", comment="Face-framing offset matrix column 0. Varies per entry.">;
    float face_col1[3] <name="Face Matrix Col1", comment="Face-framing offset matrix column 1. Varies per entry.8">;
    float face_col2[2] <name="Face Matrix Col2 (XY)", comment="Face-framing offset matrix column 2 (XY only; Z from padding_tail=0).">;

    // Tail
    uint32 padding_tail <name="Padding / Face Col2 Z", comment="Always 0; serves as Z=0 for face_col2 in global layout.">;
    uint32 enabled <name="Enabled", comment="Active/valid flag, always 1 for all entries.">;
} CutInCameraEntry <name="Camera Entry", size=0x88, bgcolor=cLtBlue>;

// Section 1: Animation Motion Preset Entry
// 7 motion preset entries, all with identical curve values.
// Loaded by CutInData_LoadParams, scattered into globals at DAT_7101abf068..DAT_7101abf0a0.
// Controls the animation playback of the cut-in slide motion.
typedef struct {
    // 12 animation curve parameters (identical across all 7 entries)
    float curve_0 <name="Curve[0]", comment="0.42 - slide onset timing">;
    float curve_1 <name="Curve[1]", comment="0.80">;
    float curve_2 <name="Curve[2]", comment="0.10">;
    float curve_3 <name="Curve[3]", comment="0.03">;
    float curve_4 <name="Curve[4]", comment="1.10 - hold / sustain">;
    float curve_5 <name="Curve[5]", comment="0.42">;
    float curve_6 <name="Curve[6]", comment="0.06">;
    float curve_7 <name="Curve[7]", comment="0.12">;
    float curve_8 <name="Curve[8]", comment="0.55">;
    float curve_9 <name="Curve[9]", comment="0.04">;
    float curve_10 <name="Curve[10]", comment="1.14">;
    float curve_11 <name="Curve[11]", comment="0.58 - fade-out">;

    // Motion type (4 bytes read individually)
    ubyte motion_mode <name="Motion Mode", comment="0x01=standard, 0x03=dual. (DAT_7101abf077)">;
    ubyte motion_flag <name="Motion Flag", comment="0x00=standard, 0x03=dual. (DAT_7101abf078)">;
    ubyte motion_unused <name="Motion Unused", comment="Always 0x00. (DAT_7101abf076)", hidden=true>;
    ubyte eye_state <name="Eye State", comment="0=open, 1=close, 3/4=special anim. (DAT_7101abf074)">;

    // Animation IDs (4 bytes, drive KTSL track selection)
    ubyte anim_id_0 <name="Anim ID[0]", comment="Always 0x02 - KTSL anim track base. (DAT_7101abf09c)">;
    ubyte anim_id_1 <name="Anim ID[1]", comment="0x09=standard, 0x08=dual - animation index. (DAT_7101abf09d)">;
    ubyte anim_id_2 <name="Anim ID[2]", comment="0x01=standard, 0x08=dual - audio stream. (DAT_7101abf075)">;
    ubyte anim_id_3 <name="Anim ID[3]", comment="Always 0x00 - unused", hidden=true>;
} CutInMotionEntry <name="Motion Entry", size=0x38, bgcolor=cLtGreen>;


typedef struct {
    SectionSubHeader sub_hdr;
    CutInCameraEntry entries[sub_hdr.entry_count] <optimize=false>;
} Section0 <name="Section 0 - Camera Params">;

typedef struct {
    SectionSubHeader sub_hdr;
    CutInMotionEntry entries[sub_hdr.entry_count] <optimize=false>;
} Section1 <name="Section 1 - Motion Presets">;

LittleEndian();
GlobalHeader hdr;
Section0 sec0;
Section1 sec1;
