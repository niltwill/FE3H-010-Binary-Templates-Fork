//------------------------------------------------
//--- 010 Editor v16.0.1 Template File
//
//      File: saveSystem.bt
//   Authors: Falo, niltwill
//   Purpose: Fire Emblem: Three Houses "system" save file
//   Version: 1.0
//
//   Layout: [12-byte header] [SaveFileInfo x37] [GlobalFlags 0x134 bytes]
//   Sizes: V5 (v1.0.x) = 0x44C |  V7 (v1.1.0+) = 0x1204
//
//   CHECKSUM: Byte sum of file bytes [0xC..EOF), stored as u32 at offset 0.
//             system file -> 32-bit sum (sum & 0xFFFFFFFF)
//             slot files -> 8-bit sum (sum & 0x000000FF)
//   SCRIPTS (run these before opening the template to fix checksum first):
//     SaveSystem_UpdateChecksum-RunTemplate.1sc -> system file (32-bit, calls saveSystem.bt)
//     SaveEntry_UpdateChecksum-RunTemplate.1sc -> slot files (8-bit, calls saveEntry.bt)
//
//   SLOT FILES (associated save data):
//     Slot[0]     -> "auto"             main game autosave
//     Slot[1-25]  -> "slot00"-"slot24"  main game player saves (25 slots)
//     Slot[26]    -> "abyss00"          DLC player save 1
//     Slot[27]    -> "abyss01"          DLC player save 2
//     Slot[28]    -> "abyss02"          DLC player save 3
//     Slot[29]    -> "ex00"             DLC autosave
//     Slot[30-36] -> (unused/reserved)
//------------------------------------------------

LittleEndian();

// Globals
local int g_Version = 0;
local int g_IsV7 = 0;
local int g_SlotCount = 0;

// Enums
typedef enum <uint32> {
    SaveVer_5_v100_v102 = 5,  // 7 slots, Flags 0x114 bytes
    SaveVer_7_v110_v120 = 7   // 37 slots, Flags 0x134 bytes
} SaveVersion_e;

// Save slot display state.
// This drives the location string and save screen behaviour.
// State 17 (0x11) = INVALID = empty slot sentinel.
// States 12-16 and 18+ = INVALID (game shows "corrupted save" message).
typedef enum <uint32> {
    BaseOps_Exploration = 0,           // Base of Operations (default - monastery exploration)
    INVALID = 1,                       // INVALID - game shows corrupted save error
    Preparations_AfterEV = 2,          // Preparations (the same battle prep screen for battles after its associated cutscene/EV finishes)
                                        // Don't use this when editing saves: use state 4 instead (using this directly may make the battle not load everything correctly!)
                                        // Then make the save after you go through the event/cutscene and reach the battle prep screen
    NewChapter = 3,                    // New Chapter (narrator/cinematic screen)
    BeforeBattle = 4,                  // Before Battle (loads what is set to happen before the scenario - use this over state 2)
    AfterBattle = 5,                   // After Battle (calendar progressing)
    BaseOps_Exploration2 = 6,          // Base of Operations (monastery exploration) - not sure about difference between 0 and 6
    BaseOps_Calendar = 7,              // Base of Operations (Byleth at calendar menu)
    Abyss = 8,                         // Abyss exploration (falls back to monastery if Abyss not unlocked)
    EmptyString = 9,                   // No strings displayed; monastery fallback (probably unused)
    SelectBattlefield = 10,            // Select Battlefield screen
    ClearedGameData_NGPlus = 11,       // Cleared-Game Data (NG+ state - shows star icon on slot header)
                                       // RE: ExtrasMenu_InitGoldEffectFlags checks slot type==0xB(11)
                                       // to enable the gold particle effect on the title screen.
                                       // Per-save flag 2050 marks this save as an active NG+ file.
                                       // GlobalFlags bytes 214/236-238 hold the NG+ content unlock bits.
    EmptySlot_Sentinel = 17            // 0x11 = empty slot (unused state)
                                       // 12-16, 18+ = INVALID (corrupted save message, do not use)
} SaveState_e;

// RouteID / banner flag.
// Interpretation depends on ChapterNum (Part I vs Part II):
//   ChapterNum 0-12  = Part I  (pre-timeskip)
//   ChapterNum 13-22 = Part II (post-timeskip)
//
// Pre-timeskip:                   Post-timeskip:
//   0 = Black Eagles                0 = Silver Snow
//   1 = Blue Lions                  1 = Azure Moon
//   2 = Golden Deer                 2 = Verdant Wind
//   3 = Black Eagles (alt?)         3 = Crimson Flower
//   4 = Silver Snow / Church        4 = Silver Snow (pre-TS variant, stays accessible)
//   5 = Cindered Shadows (DLC)      5 = Cindered Shadows (DLC)
//   6+ = No flag (fallback)         6+ = Crimson Flower (no icon, default fallback)
// Default / Prologue = 4 (Church of Seiros affiliation; Jeralt's faction)
typedef enum <uint32> {
    RouteID_0 = 0,
    RouteID_1 = 1,
    RouteID_2 = 2,
    RouteID_3 = 3,
    RouteID_4_Default_Church = 4,
    RouteID_5_CinderedShadows = 5
    // 6+ = no flag / fallback
} RouteID_e;

