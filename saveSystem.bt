// Display helpers

string FmtPlaytime(uint32 s) {
    return Str("%03d:%02d", s / 3600, (s % 3600) / 60);
}

// Decodes FE3H name-escape encoding: 1B 4E 30 [name] 1B 4E 31
// ASCII only; non-ASCII bytes (Japanese etc.) appear as '?'
string DecodeName(byte b[40]) {
    local string r = "";
    local int i, inside = 0;
    for (i = 0; i < 38; i++) {
        if (!inside && b[i]==0x1B && b[i+1]==0x4E && b[i+2]==0x30) {
            inside = 1; i += 2;
        } else if (inside && b[i]==0x1B && b[i+1]==0x4E && b[i+2]==0x31) {
            break;
        } else if (inside) {
            r += (b[i] >= 0x20 && b[i] < 0x7F) ? Str("%c", b[i]) : "?";
        }
    }
    return (r == "") ? "(encoded)" : r;
}

// Tree label shown next to each slot in the template view
string FmtSlot(struct SaveFileInfo &s) {
    if ((uint32)s.State == 17) return "[ Empty ]";
    local string n = DecodeName(s.PlayerName);
    local string t = FmtPlaytime(s.Playtime);
    local string tag;
    if ((uint32)s.RouteID == 5)
        tag = "DLC";
    else
        tag = ((uint32)s.ChapterNum < 13) ? "PartI" : "PartII";
    return Str("[%s] %s Ch.%d | State=%s | %s", n, tag, (uint32)s.ChapterNum, EnumToString(s.State), t);
}

// SaveFileInfo (0x74 bytes per slot)
typedef struct {

    // State (drives the save menu display)
    // State 17 (0x11) = empty slot sentinel  (INVALID state, not a real state)
    // States 12-16 and 18+ also invalid; game shows "corrupted save" for those too.
    SaveState_e State <bgcolor=0xC0D8FF, comment="Save display state. 17(0x11)=empty slot. 12+ invalid.">;

    // Playtime
    uint32 Playtime <bgcolor=0xC8FFC8, read=FmtPlaytime, comment="Seconds elapsed. Display = HHH:MM.">;

    // Route / banner flag
    // Dual-encoding: interpretation depends on ChapterNum (Part I vs II).
    // Pre-TS (Ch0-12): 0=BE,1=BL,2=GD,3=BE(alt),4=Church/SS,5=CS,6+=no flag
    // Post-TS (Ch13+): 0=SS,1=AM,2=VW,3=CF, 4=SS(pre-TS),5=CS,6+=CF fallback
    // Default/Prologue = 4 (Church of Seiros / Jeralt's affiliation)
    uint32 RouteID <bgcolor=0xFFE8A0, comment="Route/banner. Pre-TS: 0=BE,1=BL,2=GD,4=Church. Post-TS: 0=SS,1=AM,2=VW,3=CF,4=SS(preTS). 5=DLC. 6+=fallback.">;

    // Chapter number
    // 0-22 for base game. 1-7 for DLC (Cindered Shadows = 7 chapters).
    // Part I = Ch0-12. Part II = Ch13+.
    // Also sets the background thumbnail.
    uint32 ChapterNum <bgcolor=0xFFE8A0, comment="Chapter index 0-22 (base) / 1-7 (DLC). Ch0-12=Part I, Ch13+=Part II. Drives 'Ch.N' display and (with ScenarioNum) background image.">;

    // Calendar day
    // Day-of-month at time of save. 255 = No_Day (not in a monastery phase).
    // Month is not stored here - derived from chapter timeline.
    // Only displayed in the UI when State = 0/6/7 (monastery exploration).
    DayNum_e Day <comment="Calendar day-of-month. 255=No_Day (Before Battle / Cleared-Game etc.). Month implicit from chapter.">;

    // Padding
    // Always 0 in observed saves. Probably alignment padding.
    uint32 padding <comment="Always 0. Padding.">;

    // Scenario (battle map)
    // Identifies which specific battle map loads when entering combat.
    // 255 = No_Scenario. For pre-timeskip chapters, value == ChapterNum.
    // Post-timeskip scenarios diverge per-route (see ScenarioNum_e enum).
    ScenarioNum_e ScenarioNum <bgcolor=0xFFE8A0, comment="Which battle map to use. Controls background image. 255=No_Scenario.">;

    // Chapter-progression boolean flags (assumed)
    // All are 0 or 1 (boolean u32). Best-guess semantics:
    // unkFlag1: set=1 when State=3 (New Chapter). Hypothesis: SavedAtChapterInit.
    // unkFlag2: always 1 (both base game and DLC). Hypothesis: SavedDuringChapter.
    // unkFlag3: unknown when 1 (could be unused, if never set to 1 anywhere).
    // unkFlag4: unknown when 1 (could be unused, if never set to 1 anywhere).
    uint32 unkFlag1 <comment="Bool. Set=1 when State=3 (NewChapter). Hypothesis: SavedAtChapterInit.">;
    uint32 unkFlag2 <comment="Bool. Always=1 (base+DLC). Hypothesis: SavedDuringChapter.">;
    uint32 unkFlag3 <comment="Bool. Condition for =1 unknown.">;
    uint32 unkFlag4 <comment="Bool. Condition for =1 unknown.">;

    // Byleth name
    byte PlayerName[40] <bgcolor=0xFFFFB0, comment="Byleth name. Escape-wrapped: 1B 4E 30 [name bytes] 1B 4E 31. 40 bytes max.">;

    // Constant save-format sentinel
    // Always 0x00000097 (= 151). The game reads this to verify the entry is a
    // valid/recognised save entry. Never changes; do not edit.
    uint32 saveEntryVal <comment="Constant = 0x97 (151). Save entry format sentinel. Always 97 00 00 00.">;

    // Constant save-format version
    // Always 0x01000004 (bytes: 01 00 00 04). Encodes format version "1.0.0.4"
    // (the fourth revision of save format v1.0.0). Never changes; do not edit.
    uint32 saveEntryVer <comment="Constant = 0x01000004. Format version stamp '1.0.0.4'. Always 01 00 00 04.">;

    // Remaining unknown fields
    uint32 reserved_1 <comment="Probably just empty padding (for reserved space).">;
    uint32 reserved_2 <comment="Probably just empty padding (for reserved space).">;
    uint32 reserved_3 <comment="Probably just empty padding (for reserved space).">;
    uint32 reserved_4 <comment="Probably just empty padding (for reserved space).">;
    uint32 reserved_5 <comment="Probably just empty padding (for reserved space).">;
    uint32 reserved_6 <comment="Probably just empty padding (for reserved space).">;

} SaveFileInfo <read=FmtSlot, optimize=false>;

// Global flags (0x114 bytes V5 / 0x134 bytes V7)
//
//  Confirmed layout (from binary analysis of fresh DLC-only system file):
//
//  [0]       SystemByte        1 B  | bit 0 = first-boot/init flag
//  [1-13]    MovieFlags       13 B  | bits 8-107 = 100 cutscene viewed flags
//  [14-212]  GameplayFlags   199 B  | bits 112-1703, unknown content flags
//  [213]     DLC_AckByte       1 B  | bit 6 (0x40) = DLC ownership acknowledged
//  [214-268] UnknownFlags2    55 B  | bits 1712-2151, unknown
//  [269-275] DLC_Unlock_V5     7 B  | bits 2152-2207 (also in V5), set 0xFF x7
//  [276-305] DLC_Unlock_V7    30 B  | bits 2208-2447 (V7 only), set 0xFF x30
//  [306-307] V7_Padding        2 B  | bits 2448-2463, unused (zero)
//
//  To unlock all DLC: set DLC_Unlock_V5 = 0xFF x7 AND DLC_Unlock_V7 = 0xFF x30.

typedef struct {
    byte SystemByte <bgcolor=0xE0E8FF, comment="Bit 0 (0x01) = global init / first-boot flag. Set on startup.">;
    byte MovieFlags[13] <bgcolor=0xE0E8FF, comment="Bits 8-107: 100 cutscene unlock flags. Bit i = movie (msgbin 12823+(i-8)) viewed. All zero on fresh file.">;
    byte GameplayFlags[199] <bgcolor=0xD0ECFF, comment="Bits 112-1703: 1592 unknown gameplay flags. Zero on fresh file. Map via gameplay testing.">;
    byte DLC_AckByte <bgcolor=0xFFD090, comment="Bit 6 (0x40) = DLC ownership acknowledged (set in fresh DLC file). Other bits unknown.">;
    byte UnknownFlags2[55] <bgcolor=0xD0ECFF, comment="Bits 1712-2151: 440 unknown flags. Zero on fresh file.">;
    byte DLC_Unlock_V5[7] <bgcolor=0xFF9840, comment="Bits 2152-2207: base DLC unlock flags (also present in V5). Set all to 0xFF to unlock.">;
    if (g_IsV7) {
        byte DLC_Unlock_V7[30] <bgcolor=0xFF7820, comment="Bits 2208-2447: 240 Cindered Shadows DLC unlock flags (V7 only). Set all to 0xFF = full DLC unlock.">;
        byte V7_Padding[2] <bgcolor=0xF0F0F0, comment="Bits 2448-2463: unused tail bytes in V7 flags. Zero.">;
    }
} SystemFlags <bgcolor=0xE8FFE8>;

// Checksum verification
local uint32 stored_csum = ReadUInt(0);
local uint32 calc_csum = 0;
local uint32 ci;
for (ci = 0xC; ci < FileSize(); ci++)
    calc_csum += ReadUByte(ci);

if (stored_csum != calc_csum) {
    Printf("!!! CHECKSUM MISMATCH: stored=0x%08X  computed=0x%08X !!!\n",
           stored_csum, calc_csum);
    Printf("    Run SaveEntry_UpdateChecksum.1sc before loading or save will be rejected.\n");
} else {
    Printf("Checksum OK: 0x%08X\n", stored_csum);
}

// File header
typedef struct {
    uint32 Checksum <bgcolor=0xC0D8FF, comment="32-bit byte sum of [0xC..EOF). system file uses 32-bit; slot files use 8-bit (& 0xFF). Make sure to recompute after any edits.">;
    SaveVersion_e SaveVersion <bgcolor=0xC0D8FF, comment="5=v1.0.0-v1.0.2 (7 slots), 7=v1.1.0-v1.2.0 (37 slots)">;
    uint32 SizeOfFile <bgcolor=0xC0D8FF, comment="Total file size in bytes">;
} FileHeader;

FileHeader Header;

g_Version = (int)Header.SaveVersion;
g_IsV7 = (g_Version >= 7) ? 1 : 0;
g_SlotCount = g_IsV7 ? 37 : 7;

Printf("Version=%d | Slots=%d | V7=%d\n", g_Version, g_SlotCount, g_IsV7);

local uint32 expected = (g_IsV7 ? 0x11F8 : 0x440) + 0xC;
if (FileSize() != expected)
    Printf("WARNING: file size 0x%X != expected 0x%X\n", FileSize(), expected);

// Slot entries
local int si;
for (si = 0; si < g_SlotCount; si++)
    SaveFileInfo Slot;

// Global flags
SystemFlags Flags;

// Final check
Printf("Done. Position 0x%X / 0x%X | %s\n", FTell(), FileSize(),
       (FTell()==FileSize()) ? "OK" : "WARNING: bytes unaccounted for!");
