//------------------------------------------------
//--- 010 Editor v13.0.1 Binary Template
//
//      File: fixed_areadata.bt
//   Authors: Reichard, niltwill
//   Version: 1.1
//   Purpose: FE3H fixed_areadata.bin - Monastery zone/area layout data
//  Category: Game Data
// File Mask: fixed_areadata.bin
//   History:
//     1.0 - Reichard: initial unknown fields
//     1.1 - Thomas: reverse engineered fields; zone math + OBJD cross-reference
//------------------------------------------------

// Defines the monastery's logical zone layout: which activities happen where,
// which BGM plays per area, and the spatial rectangles used for "is player in zone X?" runtime checks.
// Corrupting this file causes the monastery to disappear, since zone data drives
// NPC placement, BGM selection, and 3D scene object activation.

LittleEndian();

typedef struct {
    uint32 section_count <name="Section Count", comment="Always 4">;
    uint32 header_size <name="Header Size", comment="Always 0x24 (36 bytes)">;
    uint32 sec0_data_size <name="Sec0 Data Size", comment="Bytes in sec0 (sub-hdr + entries). Sec0 ends at header_size + sec0_data_size.">;
    uint32 sec1_abs_start <name="Sec1 Abs Offset", comment="File offset of sec1 sub-header. May be sec0_end + 2 (alignment pad).">;
    uint32 sec1_data_size <name="Sec1 Data Size">;
    uint32 sec2_abs_start <name="Sec2 Abs Offset">;
    uint32 sec2_data_size <name="Sec2 Data Size">;
    uint32 sec3_abs_start <name="Sec3 Abs Offset">;
    uint32 sec3_data_size <name="Sec3 Data Size", comment="sec3_abs_start + sec3_data_size = EOF">;
} GlobalHeader <name="Global Header", bgcolor=cLtGray>;

typedef struct {
    uint32 magic <name="Magic", format=hex, comment="Always 0x16121900">;
    uint32 entry_count <name="Entry Count">;
    uint32 entry_stride <name="Entry Stride", format=hex>;
    byte padding[52] <name="Padding", hidden=true, comment="Always zero">;
} SubHdr <name="Sub-Header", bgcolor=cLtYellow>;

// Enums
typedef enum <ubyte> {
    Wandering_NPCRoam_0 = 0,
    UnkOutdoor_3 = 3,
    Garden_5 = 5,
    TrainingGrounds_6 = 6,
    Greenhouse_7 = 7,
    Greenhouse_8 = 8,
    Fishing_PlusOutdoorDLC_9 = 9, // Cindered Shadows DLC area, also needs the outdoor unlock
    Sauna_10 = 10,
    Fishing_PlusOutdoorDLC_11 = 11,
    Fishing_PlusOutdoorDLC_12 = 12,
    DiningHall_13 = 13,
    Sauna_14 = 14,
    Fishing_PlusOutdoorDLC_15 = 15,
    Unused_AlwaysSkipped_16 = 16,
    PreSwitchOnly_18 = 18, // hidden during White Clouds / shown on all post-timeskip routes
    Abyss_26 = 26
} enumActivityType;

typedef enum <ubyte> {
    Null = 99,
    Global = 100
} enumZoneIndex;

typedef enum <ubyte> {
    Navigation_Only = 0,
    NPC_Activities_Supported = 1
} enumHasActivities;

typedef enum <ubyte> {
    No = 0,
    Yes = 1
} enumWarpAccessible;

typedef enum <ubyte> {
    GlobalOrSpecial_0 = 0,
    Main_1 = 1,
    Upper_2 = 2,
    HighOrCathedral_3 = 3
} enumAreaGroup;

