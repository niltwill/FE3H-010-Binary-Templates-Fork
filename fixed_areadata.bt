// Activity Zone - 37 entries. Two special "global meta" entries (area_group=0, activity_type=12)
// precede the 35 area zone records. u16_0 is a G1M model ID for the zone's
// collision geometry, cross-referenced against OBJD GIMD tables (confirmed for
// entries 0 -> g1mID 108, 1 -> g1mID 112, and several others in 779–881.bin range).
typedef struct {
    uint16 g1m_id <name="G1M ID / Zone Cap", comment="G1M model ID for zone collision geometry (cross-refs OBJD GIMD table). Entries 0/1 confirmed as g1mID 108/112. Value 1 = null zone.">;
    enumZoneIndex zone_index <name="Zone Index", comment="References section 2 by its zone_index field. 99=null, 100=global (entries 0-1).">;
    enumActivityType activity_type <name="Activity Type", comment="Zone activity type. Fishing_PlusOutdoorDLC_9/11/12/15 = Cindered Shadows DLC area, also needs the outdoor unlock, PreSwitchOnly_18 = hidden during White Clouds / shown on all post-timeskip routes, 16=null/unused">;
    ubyte is_primary <name="Is Primary Zone", comment="1=primary activity zone (where NPCs gather). 0=secondary/transition zone.">;
    enumAreaGroup area_group <name="Area Group", comment="Tier grouping">;
    enumHasActivities has_activities <name="Has Activity Slots", comment="1=zone supports NPC activities. 0=navigation only.">;
    ubyte flag_b7 <name="Flag B7">;
    ubyte flag_b8 <name="Flag B8">;
    enumWarpAccessible is_warp_zone <name="Warp Accessible", comment="1=zone has or is near a warp point.">;
} Sec0Entry <name="Activity Zone", size=10, bgcolor=cLtBlue>;

// BGM Zone - 30 entries. Active 0-18 map audio IDs to named zone indices matching section 2.
// Entries 19-29 are null (all zero).
typedef struct {
    ubyte audio_id_lo <name="Audio ID Lo", comment="Low byte of audio stream/emitter ID for this zone.">;
    ubyte audio_id_hi <name="Audio ID Hi", comment="High byte. Full ID = (audio_id_hi<<8)|audio_id_lo.">;
    ubyte audio_flag <name="Audio Flag", comment="Usually 0. 6 = alternate audio routing (zones 17-18).">;
    ubyte pad <name="Padding", hidden=true, comment="Always 0.">;
    uint32 zone_index <name="Zone Index", comment="Named zone ID 0-18 for active entries. Matches section 2 zone_index.">;
} Sec1Entry <name="BGM Zone", size=8, bgcolor=cLtGreen>;

// Named Area Spatial Bounds
// 30 entries. Active zones 0-18 and 21-27. Entries 26-29 are null (zone_index=0).
// Coordinates are in tile space (world/250 - scene_center).
// Note: axis order matches Section 3 - first pair = Z axis, second pair = X axis.
// Entries 12-15 have large bit-pattern values that may be permission flags
// rather than tile coordinates. Entries 16-18 may use signed offsets.
typedef struct {
    uint16 bound_z_a <name="Z Bound A", comment="First Z tile bound (zone spans min..max of the two Z values).">;
    uint16 bound_x_a <name="X Bound A", comment="First X tile bound.">;
    uint16 bound_z_b <name="Z Bound B", comment="Second Z tile bound.">;
    uint16 bound_x_b <name="X Bound B", comment="Second X tile bound.">;
    ubyte zone_index <name="Zone Index", comment="Named zone ID (0-27). Sequential. Cross-refs sec0.zone_index and sec1.zone_index.">;
    ubyte pad[3] <name="Padding", hidden=true, comment="Always 0.">;
} Sec2Entry <name="Area Bounds", size=12, bgcolor=cLtRed>;

// Point Zone Check Slot
typedef struct {
    uint16 bound_large <name="Large Bound", comment="Larger of the two primary zone bounds. Acts as the X-axis upper limit in Zone_ContainsPosition (range with b4|(b5<<8)). Tile_X = world_X/250 - scene_center_X.">;
    uint16 bound_small <name="Small Bound", comment="Smaller paired bound. Acts as the Z-axis ceiling in Zone_ContainsPosition (lower Z = 0). Tile_Z = world_Z/250 - scene_center_Z.">;
    enumMonasteryRoom slot_index <name="Slot Index (Room ID + Lower X Bound)", comment="Self-referential slot ID 0-99 (0xFF=inactive). Also the lower X bound: u16_2=slot_index|(zone_type<<8). Also the argument for the room name. Slots 0-52=pre-TS monastery, 53-84=post-TS areas, 85-93=Abyss(CS).">;
    ubyte zone_type <name="Zone Type", comment="Zone type 0-4. Contributes to lower X bound: u16_2 = slot_index|(zone_type<<8). Also used as scene accessibility hint by loader to generate runtime byte[8] zone_accessibility_flags (bit0=CS scene 0x3C, bit1=regular scene 0x37).">;
    ubyte ero_a <name="Zero (hard lower bound)", hidden=true, comment="Always 0 in file. Forms u16_3=0 = hard lower limit of Z axis.">;
    ubyte zero_b <name="Zero (padding)", hidden=true, comment="Always 0 in file. Loader appends zone_accessibility_flags at byte[8] and room_icon at byte[9] at runtime.">;
} Sec3Entry <name="Zone Slot", size=8, bgcolor=cLtPurple>;
// Runtime note: loader expands to >=10 bytes:
//   byte[8] = zone_accessibility_flags (bit0=CS/0x3C, bit1=regular/0x37)
//   byte[9] = room icon sprite ID offset (slot_index + 0xF776)

// Important: Sections are not strictly contiguous.
// Section 0 ends at 0x1D6 but Section 1 starts at 0x1D8 (2-byte alignment gap).
// Always FSeek to the stored absolute offsets from the global header.

GlobalHeader hdr;

// Section 0 - always starts at header_size (= 0x24)
FSeek(hdr.header_size);
SubHdr sub0 <name="Sec0 Sub-Header">;
Sec0Entry sec0[sub0.entry_count] <name="Activity Zones", optimize=false>;

// Section 1 - use stored abs_start (skips the 2-byte alignment pad after sec0)
FSeek(hdr.sec1_abs_start);
SubHdr sub1 <name="Sec1 Sub-Header">;
Sec1Entry sec1[sub1.entry_count] <name="BGM Zones", optimize=false>;

// Section 2
FSeek(hdr.sec2_abs_start);
SubHdr sub2 <name="Sec2 Sub-Header">;
Sec2Entry sec2[sub2.entry_count] <name="Area Bounds", optimize=false>;

// Section 3
FSeek(hdr.sec3_abs_start);
SubHdr sub3 <name="Sec3 Sub-Header">;
Sec3Entry sec3[sub3.entry_count] <name="Zone Slots", optimize=false>;
